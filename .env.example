# Copy to .env and fill in. Never commit .env.

# --- B1: ทางออก LLM ของ ecosystem ---
# ตั้งค่านี้แล้วทุก LLM call จะออกทาง llm-gateway (OpenAI-compatible)
# ถ้าไม่ตั้ง Builder จะเตือนว่ากำลังข้าม boundary B1 แล้วยิงตรงไป provider
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=

# --- fallback: ยิงตรงไป provider (ใช้เฉพาะตอน dev) ---
DEEPSEEK_API_KEY=
ZAI_API_KEY=

# --- model catalog (เจ้าของคือ free-llm-registry) ---
# ตั้ง URL แล้ว Model Registry จะดึงรายชื่อ model จากที่นั่นแทน seed ในโค้ด
FREE_LLM_REGISTRY_URL=

# --- tools ---
GITHUB_TOKEN=
AGENT_BUILDER_FS_ROOT=

# --- MCP ---
AI_COLLAB_MCP_URL=https://ai-collaboration-mcp.monthop-gmail.workers.dev/mcp
AI_COLLAB_MCP_TOKEN=

# --- opencode zen (OpenAI-compatible gateway) ---
# ใช้เป็น gateway:  LLM_GATEWAY_BASE_URL=https://opencode.ai/zen/v1
#                   LLM_GATEWAY_API_KEY=sk-...
# หรือใช้เป็น provider ตรง ๆ ด้วยชื่อ catalog 'zen':
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=
